{
  "name": "Smartbed MQTT Reverie",
  "version": "1.1.22-reverie.20",
  "slug": "smartbed-mqtt-reverie",
  "description": "A Home Assistant add-on to enable controlling smart beds. Fork of smartbed-mqtt adding Reverie RevCB control box support.",
  "url": "https://github.com/silentnoodle3/smartbed-mqtt",
  "startup": "application",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "boot": "auto",
  "services": ["mqtt:need"],
  "host_network": true,
  "options": {
    "mqtt_host": "<auto_detect>",
    "mqtt_port": "<auto_detect>",
    "mqtt_user": "<auto_detect>",
    "mqtt_password": "<auto_detect>",
    "type": "reverie",
    "bleProxies": [
      {
        "host": "bluetooth-proxy.local"
      }
    ],
    "reverieDevices": [
      {
        "name": "RevCB_XXXX",
        "friendlyName": "Reverie Bed"
      }
    ],
    "scannerDevices": []
  },
  "schema": {
    "mqtt_host": "str",
    "mqtt_port": "str",
    "mqtt_user": "str",
    "mqtt_password": "password",
    "type": "list(reverie|scanner)",
    "bleProxies": [
      {
        "host": "str",
        "port": "int(1,65536)?",
        "password": "password?",
        "encryptionKey": "match(^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)$)?",
        "expectedServerName": "str?"
      }
    ],
    "reverieDevices": [
      {
        "name": "str",
        "friendlyName": "str"
      }
    ],
    "scannerDevices": [
      {
        "name": "str",
        "pair": "bool?"
      }
    ]
  }
}
